<?php
/**
 * هدر مشترک سیستم
 */

if (!defined('SITE_ROOT')) {
    require_once 'config.php';
}

// چک کردن ورود کاربر
if (!isset($_SESSION['user_id'])) {
    // صفحات عمومی که نیاز به ورود ندارند
    $publicPages = ['sign.php', 'index.php', '404.html'];
    $currentPage = basename($_SERVER['PHP_SELF']);
    
    if (!in_array($currentPage, $publicPages)) {
        redirect(SITE_URL . '/sign.php');
    }
}

// دریافت اطلاعات کاربر
$currentUser = null;
if (isset($_SESSION['user_id'])) {
    $currentUser = db()->selectOne(
        "SELECT * FROM users WHERE id = :id",
        [':id' => $_SESSION['user_id']]
    );
}

// شمارش پیام‌های خوانده نشده
$unreadMessages = 0;
if ($currentUser) {
    $unreadMessages = db()->count(
        'messages',
        'receiver_id = :user_id AND is_read = 0',
        [':user_id' => $currentUser['id']]
    );
}

// شمارش اعلان‌های خوانده نشده
$unreadNotifications = 0;
if ($currentUser) {
    $notificationsTable = "SELECT COUNT(*) as count FROM (
        SELECT id FROM reminders WHERE user_id = :user_id AND remind_date <= CURDATE() AND is_sent = 0
        UNION
        SELECT id FROM calendar_events WHERE user_id = :user_id AND start_date = CURDATE() AND reminder_minutes > 0
    ) as notifications";
    $result = db()->selectOne($notificationsTable, [':user_id' => $currentUser['id']]);
    $unreadNotifications = $result ? (int)$result['count'] : 0;
}
?>
